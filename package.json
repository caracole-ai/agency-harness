{
  "name": "agency-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning pnpm -r run test",
    "registre:generer": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/registre.ts generer",
    "registre:verifier": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/registre.ts verifier",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm registre:verifier",
    "veiller": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/veiller.ts",
    "remplacer": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx metiers/securite-privee/code/src/cli/remplacer.ts",
    "parler": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/parler.ts",
    "promotions": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/promotions.ts",
    "gestes": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/gestes.ts",
    "ronde": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/ronde.ts",
    "chantier": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/chantier.ts",
    "nuit": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/nuit.ts",
    "evals": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx moteur/src/cli/evals.ts",
    "interface": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx interface/src/serveur.ts",
    "rapport:html": "tsx moteur/src/cli/rapport-html.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
