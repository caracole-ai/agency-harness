# Ce qu'un client nous dit chez lui ne quitte pas cette machine.
# Seule la couche métier (metiers/) est versionnée : c'est le capital,
# et elle ne contient aucune donnée client.
clients/*
!clients/README.md

.DS_Store
*-workspace/

node_modules/
dist/
*.sqlite

# Le rapport de démonstration se régénère (metiers/securite-privee/prospection.md).
exemples/*/rapport-demo.*

# Les traces complètes des évals (PLAN-ESPACES.md § 9) : relues, jamais versionnées.
evals/traces/
